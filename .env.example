HOST=0.0.0.0
PORT=3000
# Disabled unless explicitly enabled and configured on the server.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_CONCURRENT=2
AI_RATE_PER_HOUR=10
# Hard per-process request budget. Also configure a provider-side spending cap.
AI_REQUEST_BUDGET=100
AI_MAX_OUTPUT_TOKENS=1200
# Optional explicit origin, e.g. https://mysticatlas.demo.xichugeek.com
PUBLIC_ORIGIN=
# Enable only behind a verified single trusted reverse proxy; default is false.
TRUST_PROXY=false
